# Copy to .env. Local credentials only; change before exposing the service.
POSTGRES_PASSWORD=assistant
DATABASE_URL=postgres://assistant:assistant@127.0.0.1:55432/assistant?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379/0
HTTP_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
AGENT_ADDR=127.0.0.1:50051
AGENT_TOKEN=replace-with-a-long-random-secret
# demo is deterministic and requires no model account; openai calls a compatible API.
AI_MODE=demo
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=
# Only configure an approved template matching the reminder business scenario.
WECHAT_TEMPLATE_ID=
WECHAT_TEMPLATE_FIELD=thing1
